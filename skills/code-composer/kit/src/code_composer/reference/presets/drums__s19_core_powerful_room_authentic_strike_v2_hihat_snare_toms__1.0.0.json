{
  "format": "code-composer-factory-preset/v1",
  "preset_id": "drums.s19_core_powerful_room_authentic_strike_v2_hihat_snare_toms",
  "version": "1.0.0",
  "name": "S19 Core + Dense Cymbals + Two-Plate Hi-Hat + Articulated Snare + Coupled Tom Family",
  "engine": "percussion",
  "family": "acoustic_drum_kit",
  "character": [
    "s19-core-preserved",
    "deterministic",
    "shared-kit-room",
    "performance-integrated",
    "physical-cymbal-strike",
    "dense-inharmonic-plate",
    "bow-edge-radiation",
    "two-plate-hi-hat",
    "pedal-contact-state",
    "coupled-snare-heads",
    "snare-wire-coupling",
    "rim-articulations",
    "coupled-tom-heads",
    "size-specific-tom-family",
    "tom-center-edge-articulation"
  ],
  "strengths": [
    "kick, legacy snare and legacy closed hi-hat event rendering remain byte-preserved; new hi-hat/snare articulations are explicit opt-in surfaces",
    "ride/crash preserve S27-A2 dense inharmonic plate behavior and short-tail constraints",
    "two-plate hi-hat preserves S27-B pedal/contact state behavior",
    "snare center/ghost/rimshot/cross-stick use distinct head/wire/rim excitation paths rather than gain/EQ-only variants",
    "high/mid/floor toms use size-specific two-head, cavity and shell parameters rather than pitch-shifted copies",
    "tom center/edge articulations change membrane-mode excitation and shell/contact balance causally"
  ],
  "limitations": [
    "compact modal/coupling approximation rather than a full finite-element two-head shell simulation",
    "snare-wire coupling is event-scale and deterministic; continuous strainer tension/state remains later work",
    "tom model is a compact event-scale coupled-head/cavity/shell approximation, not a full finite-element shell simulation",
    "legacy drum role generator still authors kick/snare/hat only unless a Composer Agent explicitly emits articulation names"
  ],
  "recommended_roles": [
    "drums"
  ],
  "expression_capabilities": [
    "velocity",
    "seeded_strike_variation",
    "velocity_dependent_room_excitation",
    "hi_hat_plate_state",
    "hi_hat_pedal_articulation",
    "snare_strike_position",
    "snare_rim_articulation",
    "snare_wire_response",
    "tom_family_size",
    "tom_strike_position"
  ],
