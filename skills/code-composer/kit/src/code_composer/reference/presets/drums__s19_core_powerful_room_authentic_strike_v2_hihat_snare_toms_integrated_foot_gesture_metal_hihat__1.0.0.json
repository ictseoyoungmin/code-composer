{
  "format": "code-composer-factory-preset/v1",
  "preset_id": "drums.s19_core_powerful_room_authentic_strike_v2_hihat_snare_toms_integrated_foot_gesture_metal_hihat",
  "version": "1.0.0",
  "name": "S19 Core Powerful Room Authentic Strike V2 Hi-Hat Snare Toms Integrated Foot Gesture Metal Hi-Hat",
  "engine": "percussion",
  "family": "acoustic_drum_kit",
  "character": [
    "persistent pedal state",
    "motion-coupled chick",
    "motion-coupled foot splash",
    "resonant two-plate hi-hat re-contact"
  ],
  "strengths": [
    "kick, legacy snare and legacy closed hi-hat event rendering remain byte-preserved; new hi-hat/snare articulations are explicit opt-in surfaces",
    "ride/crash preserve S27-A2 dense inharmonic plate behavior and short-tail constraints",
    "two-plate hi-hat preserves S27-B pedal/contact state behavior",
    "snare center/ghost/rimshot/cross-stick use distinct head/wire/rim excitation paths rather than gain/EQ-only variants",
    "high/mid/floor toms use size-specific two-head, cavity and shell parameters rather than pitch-shifted copies",
    "tom center/edge articulations change membrane-mode excitation and shell/contact balance causally",
    "shared room send follows authenticated articulation identity instead of treating all post-S19 events as generic hits",
    "overhead path includes a small propagation delay so dry close transients lead the room image instead of being doubled at zero time",
    "early-reflection-dominant studio room and lighter bus glue preserve stick attack while making the full kit move as one instrument",
    "explicit hi_hat_pedal_openness control curves continuously damp an already-ringing open/half-open hi-hat without synthesizing hidden pedal gestures",
    "continuous closure uses separate body/wash energy-loss constants so partial contact changes spectral decay rather than acting as one global fader",
    "S27-H discrete authored closure events remain available as exact event-time choke anchors",
    "persistent authored pedal state shapes subsequent hi-hat stick strikes without hidden automation",
    "authored hi-hat pedal curves can produce physically coupled chick/splash contact audio from motion speed and direction",
    "hi-hat edge re-contact excites dense inharmonic metal modes instead of adding a normalized broadband collision-noise layer"
  ],
  "limitations": [
    "compact deterministic studio-room approximation rather than measured microphone or room impulse responses",
    "articulation-aware room weights are authored acoustic defaults, not automatic style mapping",
    "legacy drum role generator still authors kick/snare/hat only unless a Composer Agent explicitly emits authenticated articulation names",
    "genre-specific hi-hat performance grammar is not inferred by the runtime",
    "continuous pedal trajectories must be authored explicitly as drum_control events; the runtime does not infer foot motion from genre or neighboring hits",
    "current MIDI export omits the continuous control curve while retaining audible drum notes; canonical Music IR remains the authoritative editable source",
    "pedal curves remain explicit authored controls; no genre-specific performance grammar or automatic foot motion",
    "compact modal plate/contact model is an independent deterministic approximation, not a sampled or measured commercial hi-hat"
  ],
  "recommended_roles": [
    "drums"
  ],
  "expression_capabilities": [
    "velocity",
    "seeded_strike_variation",
    "velocity_dependent_room_excitation",
