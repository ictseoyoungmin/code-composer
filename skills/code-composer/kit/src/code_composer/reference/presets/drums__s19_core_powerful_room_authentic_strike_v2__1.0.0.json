{
  "format": "code-composer-factory-preset/v1",
  "preset_id": "drums.s19_core_powerful_room_authentic_strike_v2",
  "version": "1.0.0",
  "name": "S19 Core + Powerful Room + Authentic Cymbal Strike V2",
  "engine": "percussion",
  "family": "acoustic_drum_kit",
  "character": [
    "s19-core-preserved",
    "deterministic",
    "shared-kit-room",
    "performance-integrated",
    "physical-cymbal-strike",
    "dense-inharmonic-plate",
    "bow-edge-radiation"
  ],
  "strengths": [
    "kick, snare and closed hi-hat preserve the S19 event renderer exactly before kit-level processing",
    "ride bow and crash edge use one short stick-force event followed by a dense rapidly de-phasing inharmonic plate field rather than sparse stable partials",
    "low-order bell/gong radiation is suppressed for bow/edge strikes while R2/R3 short-tail targets and S26 shared-kit room remain preserved"
  ],
  "limitations": [
    "compact deterministic modal-density approximation rather than a full nonlinear FEM/BEM cymbal simulation",
    "S27-A2 currently fixes ride to bow-like and crash to edge/shoulder-like radiation; explicit strike-position authoring remains a later contract",
    "ride bell, hi-hat openness state, toms and full drummer limb validation remain later S27 slices"
  ],
  "recommended_roles": [
    "drums"
  ],
  "expression_capabilities": [
    "velocity",
    "seeded_strike_variation",
    "velocity_dependent_room_excitation"
  ],
