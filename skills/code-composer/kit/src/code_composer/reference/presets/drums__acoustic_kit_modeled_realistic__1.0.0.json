{
  "format": "code-composer-factory-preset/v1",
  "preset_id": "drums.acoustic_kit_modeled_realistic",
  "version": "1.0.0",
  "name": "Acoustic Kit \u2014 Modeled Realistic",
  "engine": "percussion",
  "family": "acoustic_drum_kit",
  "character": [
    "acoustic-leaning",
    "coupled-head",
    "dense-cymbal",
    "deterministic",
    "dry-close-mic"
  ],
  "strengths": [
    "kick, snare and tom dry sources use reduced-order coupled batter/resonant-head, cavity and shell responses",
    "snare wire energy is driven by resonant-head motion instead of an independent noise tail",
    "hi-hat, ride and crash use dense deterministic inharmonic paired modal fields with natural beating",
    "preserves the S20 explicit articulation vocabulary while replacing the toy-like sparse acoustic core"
  ],
  "limitations": [
    "reduced-order independent physical approximation, not a fitted, sampled, or FDTD named drum kit",
    "room, overhead and microphone-array behavior are intentionally absent from S21 dry-source hardening",
    "stateful choke/residual-hit interaction remains a later state-interaction concern",
    "strike-position authoring and drummer performance grammar remain later slices"
  ],
  "recommended_roles": [
    "drums"
  ],
  "expression_capabilities": [
    "velocity",
    "seeded_strike_variation",
    "explicit_articulation",
    "coupled_acoustic_core"
  ],
