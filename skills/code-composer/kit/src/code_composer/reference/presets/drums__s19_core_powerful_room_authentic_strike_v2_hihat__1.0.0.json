  "name": "S19 Core + Dense Cymbals + Two-Plate Hi-Hat",
  "engine": "percussion",
  "family": "acoustic_drum_kit",
  "character": [
    "s19-core-preserved",
    "deterministic",
    "shared-kit-room",
    "performance-integrated",
    "physical-cymbal-strike",
    "dense-inharmonic-plate",
    "bow-edge-radiation",
    "two-plate-hi-hat",
    "pedal-contact-state"
  ],
  "strengths": [
    "kick, snare and legacy closed hi-hat event rendering remain byte-preserved; the new two-plate hi-hat is explicit opt-in articulation surface",
    "ride/crash preserve S27-A2 dense inharmonic plate behavior and short-tail constraints",
    "new hi-hat articulations model separate top/bottom plate fields plus pedal-dependent inelastic edge-collision rattle rather than decay-only variants"
  ],
  "limitations": [
    "compact event-scale collision approximation rather than a full finite-difference two-shell simulation",
    "pedal separation is authored per articulation in S27-B; continuous within-note pedal trajectories and full limb-state validation remain later slices",
    "legacy drum role generator still authors kick/snare/hat only unless a Composer Agent explicitly emits the new hi-hat articulation names"
  ],
  "recommended_roles": [
    "drums"
  ],
  "expression_capabilities": [
    "velocity",
    "seeded_strike_variation",
    "velocity_dependent_room_excitation",
    "hi_hat_plate_state",
    "hi_hat_pedal_articulation"
  ],
