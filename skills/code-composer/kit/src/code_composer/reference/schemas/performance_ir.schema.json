    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "exact",
            "fragment",
            "sequence",
            "transpose",
            "register_shift",
            "rhythm_scale",
            "rhythm_rewrite",
            "inversion",
            "retrograde",
            "cadence_rewrite",
            "ornament",
            "call",
            "response"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "semitones": {
          "type": "integer",
          "minimum": -36,
          "maximum": 36
        },
        "scale_degrees": {
          "type": "integer",
          "minimum": -14,
          "maximum": 14
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "rhythm": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -24,
            "maximum": 24
          },
          "minItems": 1
        },
        "responds_to": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "fragment"
              }
            }
          },
          "then": {
            "required": [
              "start",
              "length"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "required": [
              "scale_degrees"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "transpose",
                  "register_shift"
                ]
              }
            }
          },
          "then": {
            "required": [
              "semitones"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "rhythm_scale"
              }
            }
          },
          "then": {
            "required": [
              "factor"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "rhythm_rewrite"
              }
            }
          },
          "then": {
            "required": [
              "rhythm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "cadence_rewrite"
              }
            }
          },
          "then": {
            "required": [
              "intervals"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "ornament"
              }
            }
          },
          "then": {
            "required": [
              "start",
              "intervals",
              "rhythm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "call"
              }
            }
          },
          "then": {
            "required": [
              "intervals",
              "rhythm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "response"
              }
            }
          },
          "then": {
            "required": [
              "intervals",
              "rhythm",
              "responds_to"
            ]
          }
        }
      ]
    },
    "motifStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "source_motif_id",
        "section_id",
        "transform_chain",
        "identity_floor"
      ],
      "properties": {
        "statement_id": {
          "type": "string",
          "minLength": 1
        },
        "source_motif_id": {
          "type": "string",
          "minLength": 1
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "transform_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transform"
          },
          "minItems": 1
        },
        "identity_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cadence_rule": {
          "type": "string"
        },
        "identity_hard_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "registerPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_range",
        "preferred_range",
        "center",
        "max_span",
        "min_intervoice_distance"
      ],
      "properties": {
        "hard_range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "preferred_range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "center": {
          "type": "number",
          "minimum": 0,
          "maximum": 127
        },
        "max_span": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "min_intervoice_distance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "overlap_policy": {
          "enum": [
            "allow",
            "avoid",
            "primary_wins",
            "short_only"
          ]
        },
        "motion_policy": {
          "enum": [
            "free",
            "smooth",
            "contrary",
            "oblique",
            "stepwise_preferred"
          ]
        }
      }
    },
    "orchestrationSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_roles",
        "secondary_roles",
        "decorative_roles",
        "max_simultaneous_roles",
        "silence_roles"
      ],
      "properties": {
        "primary_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "secondary_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "decorative_roles": {
          "type": "array",
