{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-composer.local/schemas/performance_ir.schema.json",
  "title": "Code Composer Performance IR v1.16",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phrases",
    "motif_statements",
    "register_plans",
    "orchestration_sections",
    "transitions",
    "realization"
  ],
  "properties": {
    "version": {
      "const": "1.16"
    },
    "phrases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phrase"
      }
    },
    "motif_statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/motifStatement"
      }
    },
    "register_plans": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/registerPlan"
      }
    },
    "orchestration_sections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/orchestrationSection"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "microtiming",
        "velocity_variation"
      ],
      "properties": {
        "seed": {
          "type": "integer"
        },
        "microtiming": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "max_abs_ms"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_abs_ms": {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            }
          }
        },
        "velocity_variation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "max_abs"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_abs": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.15
            }
          }
        },
        "timing_quantization_guard_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "minimum_note_gap_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ensemble": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "role_pan_offsets": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": -0.5,
                "maximum": 0.5
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "curvePoint": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "phrase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phrase_id",
        "section_id",
        "role",
        "source_material",
        "start_beat",
        "duration_beats",
        "dynamic_curve",
        "timing_curve_ms",
        "gate_curve",
