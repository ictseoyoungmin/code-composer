            "bow_speed": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "allOf": [
                {
                  "contains": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "const": 0
