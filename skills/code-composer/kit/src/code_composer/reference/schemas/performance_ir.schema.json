                "type": "number",
                "minimum": 0.5,
                "maximum": 1.0
              }
            },
            "role_velocity_scales": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 1.0
              }
            },
