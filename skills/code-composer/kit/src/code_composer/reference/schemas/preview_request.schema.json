{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ymstudio.dev/code-composer/schemas/preview_request.schema.json",
  "title": "Code Composer Preview Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_score",
    "range",
    "tracks",
    "sample_rate"
  ],
  "properties": {
    "format": {
      "const": "code-composer-preview-request/v1"
    },
    "source_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "fingerprint"
      ],
      "properties": {
        "format": {
          "const": "code-composer-performance-score/v1"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "range": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_bar",
            "end_bar"
          ],
          "properties": {
            "start_bar": {
              "type": "integer",
              "minimum": 1
            },
            "end_bar": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_beat",
            "end_beat"
          ],
          "properties": {
            "start_beat": {
              "type": "number",
              "minimum": 0
            },
            "end_beat": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 48000
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
