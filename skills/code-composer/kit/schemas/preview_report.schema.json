{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ymstudio.dev/code-composer/schemas/preview_report.schema.json",
  "title": "Code Composer Preview Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "authority",
    "renderer_epoch",
    "source_song_fingerprint",
    "source_score_fingerprint",
    "execution_plan_fingerprint",
    "preview_request_fingerprint",
    "sample_rate",
    "selected_tracks",
    "range",
    "cache",
    "mix_report",
    "preview_metrics",
    "wav",
    "wav_sha256",
    "final_render_authority"
  ],
  "properties": {
    "format": {
      "const": "code-composer-preview-report/v1"
    },
    "authority": {
      "const": "draft-preview-only"
    },
    "renderer_epoch": {
      "type": "string",
      "minLength": 1
    },
    "source_song_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "source_score_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "execution_plan_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "preview_request_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "sample_rate": {
      "type": "integer"
    },
    "selected_tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "range": {
      "type": "object"
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "hits",
        "misses",
        "tracks"
      ],
      "properties": {
        "format": {
          "const": "code-composer-preview-stem-cache/v1"
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "misses": {
          "type": "integer",
          "minimum": 0
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "mix_report": {
      "type": "object"
    },
    "preview_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "peak",
        "rms",
        "clipped_sample_ratio"
      ],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak": {
          "type": "number",
          "minimum": 0
        },
        "rms": {
          "type": "number",
          "minimum": 0
        },
        "clipped_sample_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "wav": {
      "type": "string",
      "minLength": 1
    },
    "wav_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "final_render_authority": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
