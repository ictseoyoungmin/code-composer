# Repository-owned text normalization.
# Prevent fresh Windows clones from appearing as hundreds of modified files.
* text=auto eol=lf

# Windows command scripts retain native command-shell line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit binary artifacts.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.wav -text
*.mp3 -text
*.flac -text
*.ogg -text
*.m4a -text
*.mid -text
*.midi -text
*.zip -text
*.whl -text
*.pdf -text
