  "version": "1.16",
  "narrative": {
    "arc": "A private piano statement gradually acquires harmonic space and weight, then loses almost everything before returning transformed and resolved.",
    "section_intents": {
      "dawn": "Expose motif A with large breathing space and a restrained physical piano touch.",
      "memory": "Recall A with longer phrase connection and a quiet lower counterweight.",
      "bloom": "Develop rather than stack: fragment A, answer it, broaden voicing, introduce pulse only in gaps.",
      "stillness": "Remove pulse and bass; preserve only a shortened motif fragment and unresolved breath.",
      "horizon": "Return A recognizably, rhythmically broadened, with a rewritten cadence that resolves the whole piece."
    }
  },
